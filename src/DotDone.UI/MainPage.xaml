<Page
    x:Class="DotDone.UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DotDone.UI.Controls"
    xmlns:converters="using:DotDone.UI.Converters"
    xmlns:services="using:DotDone.Services"
    xmlns:vm="using:DotDone.UI.ViewModels"
    mc:Ignorable="d"
    FontFamily="{StaticResource AppFontFamily}">

    <Page.Resources>
        <converters:StatusToBrushConverter x:Key="StatusBrushConverter"/>
        <converters:StatusToGlyphConverter x:Key="StatusGlyphConverter"/>
        <converters:FlowDirectionConverter x:Key="FlowDirConverter"/>
        <converters:BoolToChevronConverter x:Key="ChevronConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullVisibilityConverter"/>
    </Page.Resources>

    <Grid x:Name="RootGrid"
          FlowDirection="{x:Bind ViewModel.CurrentLanguage, Mode=OneWay, Converter={StaticResource FlowDirConverter}}"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Line 1: Header & Global Search -->
            <RowDefinition Height="Auto"/> <!-- Line 2: Repository Bar -->
            <RowDefinition Height="Auto"/> <!-- Line 3: Activity Graph Widget -->
            <RowDefinition Height="*"/>    <!-- Line 4: Main Workspace -->
            <RowDefinition Height="Auto"/> <!-- Line 5: App Metadata Footer -->
        </Grid.RowDefinitions>

        <!-- LINE 1: TOP HEADER & GLOBAL SEARCH -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Brand / Logo & Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border CornerRadius="6" Width="28" Height="28">
                        <Image Source="Assets/logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="DotDone" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Global Search Across All Projects & Attachments -->
                <AutoSuggestBox Grid.Column="1"
                                x:Name="GlobalSearchBox"
                                PlaceholderText="{x:Bind ViewModel.L_GlobalSearchPlaceholder, Mode=OneWay}"
                                QueryIcon="Find"
                                HorizontalAlignment="Stretch"
                                MaxWidth="540"
                                Margin="16,0,16,0"
                                VerticalAlignment="Center"
                                TextChanged="GlobalSearchBox_TextChanged"
                                SuggestionChosen="GlobalSearchBox_SuggestionChosen">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="services:SearchResultItemDto">
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="14" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind LocationBreadcrumb}" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <!-- Right: Language & Theme & About -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- About DotDone -->
                    <Button Click="ShowAboutDialog_Click" ToolTipService.ToolTip="{x:Bind ViewModel.L_AboutDotDone, Mode=OneWay}" Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE946;" FontSize="14"/>
                    </Button>

                    <!-- Language Switcher -->
                    <Button Click="ToggleLanguage_Click" Style="{ThemeResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="14"/>
                            <TextBlock Text="{x:Bind ViewModel.L_LangSwitchLabel, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Theme Switcher -->
                    <Button Click="ToggleTheme_Click" ToolTipService.ToolTip="{x:Bind ViewModel.L_ThemeSwitchTooltip, Mode=OneWay}" Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE706;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LINE 2: REPOSITORY BAR -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Repository Label, Advanced Selector & Clear Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.L_RepositoryLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Advanced Filterable Repository DropDown: Title Only -->
                    <DropDownButton x:Name="RepoSelectDropDown"
                                    MinWidth="200">
                        <TextBlock Text="{x:Bind ViewModel.SelectedRepository.Title, Mode=OneWay, TargetNullValue='انتخاب مخزن...'}"
                                   FontWeight="Medium" FontSize="13"/>
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="260" Spacing="8">
                                    <TextBox Text="{x:Bind ViewModel.RepoFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{x:Bind ViewModel.L_FilterReposPlaceholder, Mode=OneWay}"
                                             FontSize="12"/>
                                    <ListView ItemsSource="{x:Bind ViewModel.FilteredRepositories, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedRepository, Mode=TwoWay}"
                                              IsItemClickEnabled="True"
                                              ItemClick="RepoItem_Click"
                                              MaxHeight="260">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RepositoryViewModel">
                                                <Grid Margin="0,3,0,3">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="13" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Create Repo Button -->
                    <Button Click="AddRepository_Click" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            <TextBlock Text="{x:Bind ViewModel.L_CreateRepo, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Edit Repo Button -->
                    <Button Click="EditRepository_Click" Style="{ThemeResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                            <TextBlock Text="{x:Bind ViewModel.L_EditRepo, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- View Repo Details Button -->
                    <Button Click="ViewRepository_Click" Style="{ThemeResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE946;" FontSize="12"/>
                            <TextBlock Text="{x:Bind ViewModel.L_ViewRepo, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Delete Repo Button -->
                    <Button Click="DeleteRepository_Click" Style="{ThemeResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                            <TextBlock Text="{x:Bind ViewModel.L_DeleteRepo, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Streak Badge (Duolingo style) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#FF5E00"
                            Padding="10,4,12,4"
                            CornerRadius="14"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsStreakVisible, Mode=OneWay, Converter={StaticResource BoolVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔥" FontSize="14"/>
                            <TextBlock Text="{x:Bind ViewModel.FormattedStreakCount, Mode=OneWay}"
                                       FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock Text="{x:Bind ViewModel.L_StreakBadge, Mode=OneWay}" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LINE 3: ACTIVITY HEATMAP WIDGET -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8,16,8">
            <StackPanel Spacing="6">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Dynamic Title: "گراف فعالیت [repoName]" بدون هیچ توضیحات اضافی -->
                        <TextBlock Text="{x:Bind ViewModel.ActivityGraphTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.HeatmapActiveDaysText, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.HeatmapDoneText, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <controls:HeatmapControl HeatmapData="{x:Bind ViewModel.CurrentHeatmap, Mode=OneWay}"
                                         Localization="{x:Bind ViewModel.Localization, Mode=OneWay}"
                                         CurrentLanguage="{x:Bind ViewModel.CurrentLanguage, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <!-- LINE 4: MAIN WORKSPACE -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="260" MaxWidth="440"/> <!-- Projects Sidebar (25% wider) -->
                <ColumnDefinition Width="*"/>                                   <!-- Tasks Board -->
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR: PROJECTS -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14,12,14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Projects Header & Action Bar: ایجاد / ویرایش / نمایش / حذف -->
                    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,12">
                        <!-- Header Title & Count -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE82D;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.L_ProjectsTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="{ThemeResource LayerFillColorAltBrush}" Padding="6,1,6,1" CornerRadius="4">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedRepository.Projects.Count, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 4 Clear Action Buttons: ایجاد / ویرایش / نمایش / حذف -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ایجاد (Create) -->
                            <Button Grid.Column="0" Click="AddProject_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Padding="2,5,2,5" Margin="0,0,2,0">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE710;" FontSize="11"/>
                                    <TextBlock Text="{x:Bind ViewModel.L_CreateProject, Mode=OneWay}" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- ویرایش (Edit) -->
                            <Button Grid.Column="1" Click="EditProject_Click"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    HorizontalAlignment="Stretch" Padding="2,5,2,5" Margin="2,0,2,0">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE70F;" FontSize="11"/>
                                    <TextBlock Text="{x:Bind ViewModel.L_EditProject, Mode=OneWay}" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- نمایش (View) -->
                            <Button Grid.Column="2" Click="ViewProject_Click"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    HorizontalAlignment="Stretch" Padding="2,5,2,5" Margin="2,0,2,0">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE946;" FontSize="11"/>
                                    <TextBlock Text="{x:Bind ViewModel.L_ViewProject, Mode=OneWay}" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- حذف (Delete) -->
                            <Button Grid.Column="3" Click="DeleteSelectedProject_Click"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    HorizontalAlignment="Stretch" Padding="2,5,2,5" Margin="2,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                    <TextBlock Text="{x:Bind ViewModel.L_DeleteProject, Mode=OneWay}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Projects List: Title Only -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.SelectedRepository.Projects, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectViewModel">
                                <Grid Margin="0,3,0,3">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- CENTRAL WORKSPACE: HEAD TASKS & SUBTASKS -->
            <Grid Grid.Column="1" Padding="20">
                <!-- Active Project Content: Shown only when a project is selected -->
                <Grid Visibility="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay, Converter={StaticResource BoolVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Project Header -->
                        <RowDefinition Height="Auto"/> <!-- Quick Add Task -->
                        <RowDefinition Height="*"/>    <!-- Task List -->
                    </Grid.RowDefinitions>

                    <!-- Project Header & Action Bar: Title + ایجاد / ویرایش / نمایش / حذف -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Project Title & HeadTask Count Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE82D;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedProject.Title, Mode=OneWay}"
                                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Background="{ThemeResource LayerFillColorAltBrush}" Padding="8,2,8,2" CornerRadius="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SelectedProject.HeadTasks.Count, Mode=OneWay}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- 4 Clear Action Buttons: ایجاد / ویرایش / نمایش / حذف -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- ایجاد (Create) -->
                            <Button Click="AddTask_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Padding="10,5,10,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.L_CreateTask, Mode=OneWay}" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- ویرایش (Edit) -->
                            <Button Click="EditSelectedTask_Click"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Padding="10,5,10,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.L_EditTask, Mode=OneWay}" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- نمایش (View) -->
                            <Button Click="ViewSelectedTask_Click"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Padding="10,5,10,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE946;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.L_ViewTask, Mode=OneWay}" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- حذف (Delete) -->
                            <Button Click="DeleteSelectedTask_Click"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Padding="10,5,10,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.L_DeleteTask, Mode=OneWay}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Quick Add Task -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <TextBox x:Name="NewTaskTextBox"
                                 PlaceholderText="{x:Bind ViewModel.L_QuickAddTaskPlaceholder, Mode=OneWay}"
                                 KeyDown="NewTaskTextBox_KeyDown"
                                 FontSize="13"
                                 CornerRadius="6"/>
                    </Grid>

                    <!-- Tasks List -->
                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.SelectedProject.HeadTasks, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedHeadTask, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HeadTaskViewModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,0,0,8"
                                        Padding="12,10,12,10"
                                        Tapped="HeadTaskCard_Tapped"
                                        Tag="{x:Bind}">
                                    <StackPanel Spacing="8">
                                        <!-- Task Main Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Status Button -->
                                                <ColumnDefinition Width="*"/>    <!-- Title & Badges -->
                                                <ColumnDefinition Width="Auto"/> <!-- Subtask badge -->
                                                <ColumnDefinition Width="Auto"/> <!-- Expand Chevron -->
                                                <ColumnDefinition Width="Auto"/> <!-- Transfer Button -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Toggle Icon -->
                                            <Button Grid.Column="0"
                                                    Click="CycleHeadTaskStatus_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="4"
                                                    Margin="0,0,10,0"
                                                    Style="{ThemeResource SubtleButtonStyle}">
                                                <FontIcon Glyph="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusGlyphConverter}}"
                                                          FontSize="16"
                                                          Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBrushConverter}}"/>
                                            </Button>

                                            <!-- Task Title & Attachments indicator -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>

                                                <!-- Attachment Icon if any -->
                                                <Border Visibility="{x:Bind Attachments.Count, Mode=OneWay, Converter={StaticResource IntVisibilityConverter}}"
                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                        Padding="6,2,6,2" CornerRadius="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE8A5;" FontSize="11"/>
                                                        <TextBlock Text="{x:Bind Attachments.Count, Mode=OneWay}" FontSize="10"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- SubTask Progress summary -->
                                            <Border Grid.Column="2"
                                                    Visibility="{x:Bind TotalSubTasksCount, Mode=OneWay, Converter={StaticResource IntVisibilityConverter}}"
                                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                                    Padding="6,2,6,2" CornerRadius="4" Margin="6,0,6,0">
                                                <TextBlock Text="{x:Bind ProgressSummary, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Expand / Collapse Chevron -->
                                            <Button Grid.Column="3"
                                                    Click="ToggleSubTasksExpand_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="4"
                                                    Style="{ThemeResource SubtleButtonStyle}">
                                                <FontIcon Glyph="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource ChevronConverter}}"
                                                          FontSize="12"/>
                                            </Button>

                                            <!-- Transfer Task Button -->
                                            <Button Grid.Column="4"
                                                    Click="TransferTaskRow_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="6,4,6,4"
                                                    ToolTipService.ToolTip="{x:Bind L_TransferTaskTooltip, Mode=OneWay}"
                                                    Style="{ThemeResource SubtleButtonStyle}">
                                                <FontIcon Glyph="&#xE8DE;" FontSize="14"/>
                                            </Button>
                                        </Grid>

                                        <!-- Expanded Subtasks Area -->
                                        <StackPanel Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolVisibilityConverter}}"
                                                    Margin="32,4,0,4" Spacing="6">
                                            <!-- Subtasks list -->
                                            <ListView ItemsSource="{x:Bind SubTasks, Mode=OneWay}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SubTaskViewModel">
                                                        <Grid Margin="0,2,0,2" Tag="{x:Bind}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Subtask Status Toggle -->
                                                            <Button Grid.Column="0" Click="CycleSubTaskStatus_Click" Tag="{x:Bind}"
                                                                    Padding="2" Margin="0,0,8,0" Style="{ThemeResource SubtleButtonStyle}">
                                                                <FontIcon Glyph="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusGlyphConverter}}"
                                                                          FontSize="13"
                                                                          Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBrushConverter}}"/>
                                                            </Button>

                                                            <TextBlock Text="{x:Bind Title}" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>

                                                            <!-- Uniform Subtask Action Buttons: View, Edit, Delete -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                                <!-- نمایش (View) -->
                                                                <Button Click="ViewSubTask_Click"
                                                                        Tag="{x:Bind}"
                                                                        Padding="4"
                                                                        ToolTipService.ToolTip="{x:Bind L_ViewTask, Mode=OneWay}"
                                                                        Style="{ThemeResource SubtleButtonStyle}">
                                                                    <FontIcon Glyph="&#xE946;" FontSize="11"/>
                                                                </Button>

                                                                <!-- ویرایش (Edit) -->
                                                                <Button Click="EditSubTask_Click"
                                                                        Tag="{x:Bind}"
                                                                        Padding="4"
                                                                        ToolTipService.ToolTip="{x:Bind L_EditTask, Mode=OneWay}"
                                                                        Style="{ThemeResource SubtleButtonStyle}">
                                                                    <FontIcon Glyph="&#xE70F;" FontSize="11"/>
                                                                </Button>

                                                                <!-- حذف (Delete) -->
                                                                <Button Click="DeleteSubTask_Click"
                                                                        Tag="{x:Bind}"
                                                                        Padding="4"
                                                                        ToolTipService.ToolTip="{x:Bind L_DeleteTask, Mode=OneWay}"
                                                                        Style="{ThemeResource SubtleButtonStyle}">
                                                                    <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                            <!-- Add Subtask Input -->
                                            <TextBox PlaceholderText="{x:Bind L_QuickAddSubTaskPlaceholder, Mode=OneWay}"
                                                     KeyDown="NewSubTaskTextBox_KeyDown"
                                                     Tag="{x:Bind}"
                                                     FontSize="12"
                                                     CornerRadius="4"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Empty State: Shown when no project is selected -->
                <Grid Visibility="{x:Bind ViewModel.IsProjectSelected, Mode=OneWay, Converter={StaticResource BoolVisibilityConverter}, ConverterParameter=Invert}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE82D;" FontSize="44" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.L_SelectProjectPrompt, Mode=OneWay}"
                                   FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- LINE 5: FOOTER APP METADATA SECTION -->
        <Border Grid.Row="4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6,16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Dedicated App Information Section (Producer, Release Date, Version) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <!-- Producer / تولید کننده -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.L_ProducerLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.AppProducer}" FontSize="12" FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Width="1" Height="14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>

                    <!-- Release Date / تاریخ انتشار -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.L_ReleaseDateLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.AppReleaseDate}" FontSize="12" FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Width="1" Height="14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>

                    <!-- Version / ورژن -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.L_VersionLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,1,6,1">
                            <TextBlock Text="{x:Bind ViewModel.AppVersion}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Right Side: About Dialog Trigger -->
                <Button Grid.Column="2"
                        Click="ShowAboutDialog_Click"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,4,8,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE946;" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.L_AboutDotDone, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
