<UserControl
    x:Class="DotDone.UI.Controls.HeatmapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Level0Brush" Color="#282D35"/>
        <SolidColorBrush x:Key="Level1Brush" Color="#128A40"/>
        <SolidColorBrush x:Key="Level2Brush" Color="#26B24A"/>
        <SolidColorBrush x:Key="Level3Brush" Color="#39DA5C"/>
        <SolidColorBrush x:Key="Level4Brush" Color="#8CF09B"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Spacing="8">
            <Canvas x:Name="HeatmapCanvas" Height="125" Width="950" Margin="4,4,4,4"/>
            
            <!-- Legend -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,0,8,0">
                <TextBlock Text="Less" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" x:Name="TxtLess"/>
                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{StaticResource Level0Brush}"/>
                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{StaticResource Level1Brush}"/>
                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{StaticResource Level2Brush}"/>
                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{StaticResource Level3Brush}"/>
                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{StaticResource Level4Brush}"/>
                <TextBlock Text="More" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" x:Name="TxtMore"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
