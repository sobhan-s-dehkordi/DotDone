<Application
    x:Class="DotDone.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn, Segoe UI Variable Display, Segoe UI</FontFamily>

                    <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
                    <x:Double x:Key="ContentDialogMaxHeight">750</x:Double>

                    <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                    </Style>

                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn, Segoe UI Variable Display, Segoe UI</FontFamily>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn, Segoe UI Variable Display, Segoe UI</FontFamily>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn, Segoe UI Variable Display, Segoe UI</FontFamily>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
