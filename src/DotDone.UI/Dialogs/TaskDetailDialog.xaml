<ContentDialog
    x:Class="DotDone.UI.Dialogs.TaskDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:enums="using:DotDone.Core.Enums"
    xmlns:vm="using:DotDone.UI.ViewModels"
    mc:Ignorable="d"
    FlowDirection="{x:Bind ViewModel.FlowDirection, Mode=OneWay}"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.L_Save, Mode=OneWay}"
    CloseButtonText="{x:Bind ViewModel.L_Cancel, Mode=OneWay}"
    DefaultButton="Primary"
    FontFamily="{StaticResource AppFontFamily}"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <ScrollViewer MaxHeight="380" Width="470" HorizontalAlignment="Center" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="4,2,4,4">
            <!-- Title & Status Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBox Grid.Column="0"
                         Header="{x:Bind ViewModel.L_Title, Mode=OneWay}"
                         Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{x:Bind ViewModel.L_TitlePlaceholder, Mode=OneWay}"
                         CornerRadius="6"
                         Margin="0,0,10,0"/>

                <!-- Status -->
                <ComboBox Grid.Column="1"
                          Header="{x:Bind ViewModel.L_Status, Mode=OneWay}"
                          x:Name="StatusComboBox"
                          HorizontalAlignment="Stretch"
                          CornerRadius="6">
                    <ComboBoxItem Content="{x:Bind ViewModel.L_StatusTodo, Mode=OneWay}" Tag="{x:Bind enums:ItemStatus.Todo}"/>
                    <ComboBoxItem Content="{x:Bind ViewModel.L_StatusInProgress, Mode=OneWay}" Tag="{x:Bind enums:ItemStatus.InProgress}"/>
                    <ComboBoxItem Content="{x:Bind ViewModel.L_StatusDone, Mode=OneWay}" Tag="{x:Bind enums:ItemStatus.Done}"/>
                </ComboBox>
            </Grid>

            <!-- Description -->
            <StackPanel Spacing="4">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8D2;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.L_Description, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.DescriptionCounter, Mode=OneWay}"
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <TextBox Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="500"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="65"
                         CornerRadius="6"
                         PlaceholderText="{x:Bind ViewModel.L_DescriptionPlaceholder, Mode=OneWay}"/>
            </StackPanel>

            <!-- Review / Completion Notes -->
            <StackPanel Spacing="4">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.L_ReviewNotes, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ReviewNotesCounter, Mode=OneWay}"
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <TextBox Text="{x:Bind ViewModel.ReviewNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="500"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="65"
                         CornerRadius="6"
                         PlaceholderText="{x:Bind ViewModel.L_ReviewNotesPlaceholder, Mode=OneWay}"/>
            </StackPanel>

            <!-- Attachments -->
            <StackPanel Spacing="6">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.L_Attachments, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource LayerFillColorAltBrush}" Padding="6,1,6,1" CornerRadius="4">
                            <TextBlock Text="{x:Bind ViewModel.Attachments.Count, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <Button Content="{x:Bind ViewModel.L_AddFile, Mode=OneWay}" HorizontalAlignment="Right"
                            Click="AddAttachment_Click" Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="6" Padding="10,4,10,4"/>
                </Grid>

                <ListView ItemsSource="{x:Bind ViewModel.Attachments, Mode=OneWay}"
                          SelectionMode="None"
                          MaxHeight="100"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          Background="{ThemeResource LayerFillColorAltBrush}"
                          CornerRadius="6">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttachmentViewModel">
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Margin="0,0,8,0" Grid.Column="0" VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{x:Bind OriginalFileName}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock Text="{x:Bind FormattedSize}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="{x:Bind L_OpenFile, Mode=OneWay}"
                                            Click="OpenAttachment_Click" Tag="{x:Bind}"
                                            CornerRadius="4" Padding="6,2,6,2" FontSize="11"
                                            Style="{ThemeResource DefaultButtonStyle}"/>

                                    <Button Content="{x:Bind L_Delete, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            CornerRadius="4" Padding="6,2,6,2" FontSize="11"
                                            Style="{ThemeResource SubtleButtonStyle}">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8" Width="200">
                                                    <TextBlock Text="{x:Bind L_DeleteAttachmentConfirmMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/>
                                                    <Button Content="{x:Bind L_Delete, Mode=OneWay}"
                                                            Click="ConfirmDeleteAttachment_Click" Tag="{x:Bind}"
                                                            HorizontalAlignment="Right"
                                                            Style="{ThemeResource AccentButtonStyle}" Padding="8,3,8,3" FontSize="11"/>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Metadata Info Footer Card -->
            <Border Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="12,8,12,8"
                    CornerRadius="6"
                    Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center">
                        <Run Text="{x:Bind ViewModel.L_CreatedDateLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Run Text=" "/><Run Text="{x:Bind ViewModel.FormattedCreatedDate, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <TextBlock Grid.Column="1" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Run Text="{x:Bind ViewModel.L_ModifiedDateLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Run Text=" "/><Run Text="{x:Bind ViewModel.FormattedModifiedDate, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
